# DeepSeek API
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Database (SQLite: no config needed)
DATABASE_URL=sqlite:///replenishment.db

# App
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# Decision Engine
DECISION_MAX_TOOL_ROUNDS=10
DECISION_TEMPERATURE=0.3
DECISION_LLM_MODEL=deepseek-chat

# Conversation Engine
CONVERSATION_TEMPERATURE=0.7
CONVERSATION_LLM_MODEL=deepseek-chat
CONVERSATION_MAX_HISTORY=10

# Embedding（阶段二 向量检索；不配则自动回退结构化检索）
# 硅基流动免费档：https://cloud.siliconflow.cn 申请后填 EMBEDDING_API_KEY=sk-xxx
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_TOP_K=3
